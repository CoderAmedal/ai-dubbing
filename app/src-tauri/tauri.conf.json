{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI 配音工作台",
  "version": "0.1.0",
  "identifier": "com.aidubbing.workbench",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:8756",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AI 配音工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png"
    ]
  }
}
